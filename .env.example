# Wakeel environment configuration
# Copy to `.env` and fill in real values locally. NEVER commit `.env`.

# --- Compass / LLM endpoint (OpenAI-protocol compatible) ---
OPENAI_API_KEY=
OPENAI_BASE_URL=

# --- Model selection by tier (resolved in app/llm.py) ---
DEFAULT_MODEL=gpt-4.1
REASONING_MODEL=gpt-5.1
EMBEDDING_MODEL=text-embedding-3-large

# Optional: dedicated Arabic model for the Interviewer (e.g. Jais).
# If unset, the Interviewer falls back to DEFAULT_MODEL with Arabic-aware prompting.
INTERVIEWER_MODEL=

# --- Development quota discipline ---
# When true, caps max_tokens to a small default if the caller does not specify.
SAMPLE_MODE=true

# When true (or when OPENAI_API_KEY is empty), the LLM wrapper returns
# deterministic stub responses instead of calling the network. Lets the full
# graph, loops, UI, and audit logs run without credentials or quota usage.
OFFLINE_MODE=false

# --- Service wiring ---
# Backend URL the Streamlit UI calls.
WAKEEL_BACKEND_URL=http://localhost:8000

# --- Vector store ---
CHROMA_DIR=./data/chroma
CORPUS_CONFIG=./data/corpus/corpus_config.json

# --- Logging ---
LOG_DIR=./logs
