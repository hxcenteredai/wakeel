# =============================================================================
# Wakeel — Environment Variables Template
# =============================================================================
# Copy this file to .env and fill in real values.
# NEVER commit .env to git. Organisers will inject these at evaluation time.
# =============================================================================

# -----------------------------------------------------------------------------
# LLM Provider (OpenAI-protocol compatible endpoint)
# -----------------------------------------------------------------------------
# For Compass (Core42 sovereign platform):
#   OPENAI_BASE_URL=https://compass.core42.ai/v1
# For OpenAI direct (development fallback only):
#   OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=your-api-key-here
OPENAI_BASE_URL=https://compass.core42.ai/v1

# -----------------------------------------------------------------------------
# Model Selection
# -----------------------------------------------------------------------------
# Agents request a tier ("standard" or "reasoning"), not a model name.
# The LLM wrapper resolves tier -> model via these env vars.
# Swap models (including testing Jais for Interviewer) by changing these only.
DEFAULT_MODEL=gpt-4.1
REASONING_MODEL=gpt-5.1
EMBEDDING_MODEL=text-embedding-3-large

# Optional: override the model for a specific agent (e.g. test Jais on Interviewer)
# AGENT_MODEL_OVERRIDE_INTERVIEWER=jais-30b-chat

# -----------------------------------------------------------------------------
# Operational
# -----------------------------------------------------------------------------
# SAMPLE_MODE caps max_tokens for quota discipline during development.
# Set to "false" only in production / evaluation runs.
SAMPLE_MODE=true
SAMPLE_MODE_MAX_TOKENS=300

# Retry behaviour for transient LLM errors
LLM_RETRY_ATTEMPTS=4
LLM_RETRY_MIN_WAIT_SECONDS=2
LLM_RETRY_MAX_WAIT_SECONDS=30

# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
API_PORT=8000
UI_PORT=8001
LOG_LEVEL=INFO
LOG_DIR=./logs

# -----------------------------------------------------------------------------
# Corpus / Vector Store
# -----------------------------------------------------------------------------
CORPUS_DIR=./data/corpus
CHROMADB_PATH=./data/corpus/chromadb
EMBEDDING_BATCH_SIZE=50

# -----------------------------------------------------------------------------
# Loop Iteration Caps (per PRD section 7)
# -----------------------------------------------------------------------------
MAX_DEBATE_ROUNDS=3
MAX_VALIDATOR_RETRIES=3
MAX_CITATION_RETRIES=3
MAX_COUNTER_PROPOSAL_RETRIES=3
